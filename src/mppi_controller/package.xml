<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mppi_controller</name>
  <version>0.0.0</version>
  <description>MPPI controller package with CUDA acceleration</description>
  <maintainer email="you@example.com">ubuntu22</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <depend>eigen</depend>
  <depend>eigen3_cmake_module</depend>
  
  <build_depend>libomp-dev</build_depend>
  <exec_depend>libomp-dev</exec_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>